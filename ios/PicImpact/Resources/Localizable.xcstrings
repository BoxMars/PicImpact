    "Album.randomSortDesc": {
      "extractionState": "manual",
      "localizations": {
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，每次加载相册时会随机打乱图片顺序。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, the image order will be randomly shuffled each time the album is loaded."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、アルバムを読み込むたびに画像の順序がランダムに変更されます。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，每次加載相簿時會隨機打亂圖片順序。"
          }
        }
      }
    },
